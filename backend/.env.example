# ---- Django ----
DEBUG=True
SECRET_KEY=change-me-please
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT signing key (leave empty to fall back to SECRET_KEY)
JWT_SIGNING_KEY=

# ---- Database / cache (production) ----
# Leave DATABASE_URL unset for local dev (SQLite + in-memory cache).
# Point it at PostgreSQL in production; the shared rate-limit cache then
# lives on the same server (run `manage.py createcachetable` after migrate).
# DATABASE_URL=postgres://user:password@host:5432/statusmonitor
# DB_CONN_MAX_AGE=60

# ---- Error reporting / email ----
# Errors stay local (console) until a DSN is provided.
# SENTRY_DSN=https://public@sentry.example.com/123
# Email uses the console backend in dev; a real provider (SMTP/SES/…) lands
# with the account-lifecycle milestone. Override EMAIL_BACKEND and
# DEFAULT_FROM_EMAIL here if you already have one.

# ---- CORS (comma separated) ----
# DEBUG=True automatically allows the Vite dev origins; production must list
# its own front door explicitly (never '*', credentials are enabled).
# Example production value:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Reverse proxy trust (DoS guard) ----
# X-Forwarded-For is only believed when the request comes from one of these IPs.
# Add the edge IPs of your platform (Render/Vercel) in production.
USE_X_FORWARDED_HOST=False
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ---- Legal / compliance ----
# Version stamped on every registration as proof of consent. Bump it whenever
# you publish new Terms/Privacy text (the text itself lives in the Policy table,
# seeded by migration accounts.0007 and editable in the Django admin).
TOS_VERSION=1.0

# ---- Self-monitor (your own site, monitored via cron) ----
# Point this at YOUR public front door so that when you go down, your own
# monitor notices. Local dev can keep the harmless placeholder below.
# Production: SELF_MONITOR_URL=https://your-project.vercel.app
# Do NOT point it at UptimeRobot / BetterStack / any third-party uptime service:
# those stay up when you are down, which masks exactly the outage you care about.
SELF_MONITOR_URL=https://example.com
SELF_MONITOR_NAME=Example.com

# ---- Polar.sh (billing, test mode) ----
# Organization access token (Settings → Developers → New token).
POLAR_ACCESS_TOKEN=
# Per-webhook signing secret (Settings → Webhooks → create one for /api/billing/webhook).
# Polar uses the Standard Webhooks scheme; the secret looks like whsec_...
POLAR_WEBHOOK_SECRET=
# Product ids for each paid plan (Products → copy id, looks like prod_...).
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_BUSINESS=
# Use the sandbox environment instead of production.
POLAR_USE_SANDBOX=False

# ---- Region identity (multi-region check labelling) ----
# One process per region; cron/run-checks stamps each Check with this label.
REGION_NAME=local
# TLS expiry alert thresholds (days remaining).
SSL_WARN_DAYS=30
SSL_CRITICAL_DAYS=7
# Domain registration expiry alert thresholds (days remaining).
DOMAIN_WARN_DAYS=30
DOMAIN_CRITICAL_DAYS=7

# ---- Keyword / broken-link checks ----
# Only this much of a page body is inspected for keyword checks.
CHECK_MAX_BODY_BYTES=524288
# Broken-link crawls stop after this many seconds per run.
CRAWL_MAX_SECONDS=45

# ---- Admin surface (Django admin is opt-in) ----
# Off unless explicitly enabled; turn on only while you need the UI.
ADMIN_ENABLED=False
# Mount point (use a random, deployment-specific value in production).
ADMIN_PATH=/admin/
# Optional CIDR allow-list, e.g. 203.0.113.7,10.0.0.0/8 ("*" allows everyone).
ADMIN_IP_ALLOWLIST=
# Failed admin logins before the IP is auto-blocked (default 5 / 15 min / 1 h).
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_WINDOW=900
ADMIN_LOGIN_LOCK_SECONDS=3600
ADMIN_LOGIN_DELAY_SECONDS=0.4
ADMIN_RATE_LIMIT_PER_MIN=120
# Where security alerts (blocked IP, new-IP admin login) are emailed.
ADMIN_ALERT_EMAIL=
# Admin sessions expire after 30 minutes (Django's default is two weeks).
SESSION_COOKIE_AGE=1800

# ---- Application login protection (per username) ----
# Independent of IP so a distributed attack (or a shared proxy IP) cannot lock
# an account out forever; 10 failures / 15 min triggers a 10-minute lock.
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_WINDOW=900
LOGIN_LOCK_SECONDS=600
# Health diagnostics: leave False in production (exception details stay in logs).
HEALTH_VERBOSE=False

# ---- Scheduler (container / external driver) ----
# Shared secret for POST /api/admin/scheduler/{job} (X-Scheduler-Token header).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_TOKEN=

# ---- Deployment (Render / Vercel / Supabase) ----
# On Render set TRUSTED_PROXY_IPS=* so X-Forwarded-For is trusted (else every
# visitor shares the proxy IP and rate limiting/auto-blocking misbehaves).
# TRUSTED_PROXY_IPS=*
# Hop count: 1 = direct Render, 2 = Vercel -> Render (verify with debug_proxy).
# PROXY_HOPS=2
# Supabase pooler URL, with SSL required:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Frontend origin (also used for the Polar success redirect).
# FRONTEND_URL=https://your-app.vercel.app
# COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# ---- Email (console by default; SMTP in production) ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Status Monitor <alerts@example.com>
