# ===========================================================================
# Render environment template — copy to `render.env` (git-ignored) or paste
# each value into Render → Service → Environment. Placeholders only: NEVER
# commit real tokens, and do not create a `render.env` in a public repo.
#
# Render injects PORT and RENDER_EXTERNAL_HOSTNAME automatically.
# The Blueprint (render.yaml) generates SECRET_KEY, JWT_SIGNING_KEY and
# SCHEDULER_TOKEN for you; the values below are for a manual setup.
# ===========================================================================

# ---------- Core ----------
DEBUG=False
# python -c "import secrets; print(secrets.token_ulsan(64))"
SECRET_KEY=<generate-a-64-char-random-secret>
JWT_SIGNING_KEY=<generate-a-second-independent-secret>
ALLOWED_HOSTS=status-monitor-api.onrender.com
# Supabase pooler URL (IPv6-safe; keep ?sslmode=require).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_CONN_MAX_AGE=60

# ---------- TLS / cookies / proxy ----------
COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
# Trust the managed proxy's X-Forwarded-For header. Only use "*" when the
# service is never reachable except through that proxy (Render guarantees this).
TRUSTED_PROXY_IPS=*
# Number of trusted proxy hops appended to X-Forwarded-For.
#   1 = browser -> Render -> app (direct Render host / no Vercel rewrite)
#   2 = browser -> Vercel -> Render -> app (Vercel proxies /api/*)
# Verify with `python manage.py debug_proxy` once deployed.
PROXY_HOPS=1
SESSION_COOKIE_AGE=1800

# ---------- Frontend / CORS ----------
FRONTEND_URL=https://your-app.vercel.app
# Leave EMPTY while frontend/vercel.json proxies /api/* (same-origin).
# Only set this if the SPA calls the Render host directly.
CORS_ALLOWED_ORIGINS=

# ---------- Scheduler ----------
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_TOKEN=<generate-a-32-byte-token>

# ---------- Admin (keep OFF until needed) ----------
ADMIN_ENABLED=False
ADMIN_PATH=/ops-<random-slug>/
ADMIN_IP_ALLOWLIST=
ADMIN_ALERT_EMAIL=alerts@your-domain.com
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_WINDOW=900
ADMIN_LOGIN_LOCK_SECONDS=3600
ADMIN_LOGIN_DELAY_SECONDS=0.4
ADMIN_RATE_LIMIT_PER_MIN=120

# ---------- App login protection ----------
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_WINDOW=900
LOGIN_LOCK_SECONDS=600

# Health diagnostics (leave False in production).
# HEALTH_VERBOSE=False

# ---------- Email / SMTP (alerts + notification channels) ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-username>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Status Monitor <alerts@your-domain.com>

# ---------- Polar (sandbox first, then live) ----------
POLAR_USE_SANDBOX=True
POLAR_ACCESS_TOKEN=polar_oat_<sandbox-token>
POLAR_PRODUCT_PRO=prod_<pro-product-id>
POLAR_PRODUCT_BUSINESS=prod_<business-product-id>
POLAR_WEBHOOK_SECRET=whsec_<webhook-secret>

# ---------- Monitoring / region / optional ----------
REGION_NAME=render
SELF_MONITOR_URL=https://your-app.vercel.app
SENTRY_DSN=
# SSL_WARN_DAYS=30
# SSL_CRITICAL_DAYS=7
# DOMAIN_WARN_DAYS=30
# DOMAIN_CRITICAL_DAYS=7
# CHECK_MAX_REDIRECTS=5
# CRAWL_MAX_SECONDS=45
