# Linux cron: run due monitor checks every minute.
# The command itself respects each monitor's own check interval,
# so this single cron line covers all monitors and tiers.
#
#   crontab -e   →   add:
# * * * * * cd /path/to/Status_Monitor/backend && /path/to/.venv/bin/python manage.py run_checks >> /var/log/status_monitor_checks.log 2>&1
# * * * * * cd /path/to/Status_Monitor/backend && /path/to/.venv/bin/python manage.py deliver_notifications >> /var/log/status_monitor_notify.log 2>&1
# # TLS certificate expiry sweep, once a day at 06:00:
# 0 6 * * * cd /path/to/Status_Monitor/backend && /path/to/.venv/bin/python manage.py check_ssl >> /var/log/status_monitor_ssl.log 2>&1
