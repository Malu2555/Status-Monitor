    "audit:mobile": "node scripts/mobile-audit.mjs",
    "postinstall": "npm run api:gen",
    "prebuild": "npm run api:gen && npm run seo:gen",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.3",
